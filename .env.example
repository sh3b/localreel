############################
# Self-hosting (Docker)    #
############################
# Copy to .env, then `mkdir -p` the two directories below. They must be owned
# by PUID:PGID or the containers can't write to them.

MEDIA_PATH=./library/media
DOWNLOADS_PATH=./library/downloads

# Postgres credentials. Change the password; use only A-Za-z0-9.
DB_USER=localreel
DB_PASSWORD=localreel
DB_NAME=localreel

# Worker tuning
DOWNLOAD_POLL_INTERVAL_SEC=5
TRANSCODE_POLL_INTERVAL_SEC=5
TRANSCODE_TIMEOUT_SEC=3600

# uid/gid the app containers run as, the owner of the directories above
# (find yours with `id -u` / `id -g`).
# PUID=1000
# PGID=1000

# Web UI port
# HTTP_PORT=8080

# Store Postgres in a host directory instead of a Docker volume. Not a network
# share: Postgres can corrupt there.
# PGDATA_PATH=./library/pgdata

# DB_LOG_STATEMENT=all
