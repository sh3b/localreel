# Copy to .env; README.md has the install steps.

# Postgres. Change the password; use only letters and digits.
DB_USER=localreel
DB_PASSWORD=localreel
DB_NAME=localreel

# Where videos are kept. Create it first, owned by PUID:PGID.
DOWNLOADS_DIR=./data/downloads

# User/group owning DOWNLOADS_DIR.
PUID=1000
PGID=1000
